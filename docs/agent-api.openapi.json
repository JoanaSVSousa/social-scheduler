  "components": {
    "securitySchemes": {
      "agentBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Read or classify token; browser cookies do not authorize this API."
      }
    },
    "schemas": {
      "Post": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "content_format": {
            "type": "string"
          },
          "copy": {
            "type": "string"
          },
          "hashtags": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "scheduled",
              "published",
              "failed"
            ]
          },
          "classification": {
            "type": "string",
            "nullable": true,
            "enum": [
              "all_green",
              "news",
              null
            ]
          },
          "article_id": {
            "type": "integer",
            "nullable": true
          },
          "article_url": {
            "type": "string",
            "nullable": true
          },
          "article_title": {
            "type": "string",
            "nullable": true
          },
          "scheduled_at": {
            "type": "string",
            "nullable": true
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "occurrences": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "title",
          "source_type",
          "platform",
          "content_format",
          "copy",
          "hashtags",
          "timezone",
          "created_at",
          "updated_at",
          "version",
          "id",
          "status",
          "classification",
          "article_id",
          "article_url",
          "article_title",
          "scheduled_at",
          "media",
          "occurrences"
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ClassificationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "classification",
          "reason",
          "expected_version",
          "client_request_id"
        ],
        "properties": {
          "classification": {
            "type": "string",
            "enum": [
              "all_green",
              "news"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "expected_version": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "client_request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "ClassificationResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "operation_id": {
            "type": "string"
          },
          "post_id": {
            "type": "integer"
          },
          "previous_classification": {
            "type": "string",
            "nullable": true
          },
          "classification": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "changed": {
            "type": "boolean"
          },
          "readback": {
            "type": "boolean"
          },
          "already_applied": {
            "type": "boolean"
          },
          "post": {
            "$ref": "#/components/schemas/Post"
          }
        }
      }
    }
  }
}
